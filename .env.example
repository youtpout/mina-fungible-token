# Never use a mainnet private key for development.
MINA_PRIVATE_KEY=EK_REPLACE_WITH_A_DEVNET_PRIVATE_KEY
MINA_TOKEN_ADDRESS=B62_REPLACE_WITH_THE_TOKEN_CONTRACT_ADDRESS
MINA_RECEIVER_ADDRESS=B62_REPLACE_WITH_THE_RECEIVER_ADDRESS
# The minascan Devnet node hangs on sendZkapp; this one accepts it.
MINA_GRAPHQL_URL=https://mina-devnet-graphql.aurowallet.com/graphql

# Amount in the token's smallest unit.
MINA_TRANSFER_AMOUNT=1000000000
